
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Siglo Online</title>
<style>
*{box-sizing:border-box}
body{margin:0;padding:20px;background:#10251f;color:white;font-family:Arial,sans-serif}
main{max-width:650px;margin:auto}
h1{text-align:center;color:#f4cf75;font-size:38px}
.sub{text-align:center;color:#c5d5cc}
.card{background:#1c3930;border:1px solid #416453;border-radius:16px;padding:18px;margin:14px 0}
input,button{font-size:16px;border-radius:9px;padding:12px;border:0}
input{width:100%;margin:6px 0 12px}
button{background:#f4cf75;color:#173128;font-weight:bold;cursor:pointer;margin:4px 2px}
.secondary{background:#d7e4dd}
.chips{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin:18px 0}
.chip{width:68px;height:68px;border-radius:50%;background:#f9f0d7;color:#173128;border:5px double #bd9c52;display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:bold}
.player{padding:12px;border-radius:10px;background:#29483c;margin:8px 0}
.active{outline:2px solid #f4cf75}
.big{font-size:32px;color:#f4cf75;font-weight:bold}
.small{font-size:13px;color:#c5d5cc}
#game{display:none}
</style>
</head>
<body>
<main>
<h1>♠ SIGLO ♠</h1>
<div class="sub">El juego de los amigos</div>
<section id="setup" class="card">
<h2>Crear partida</h2>
<label>Nombres de los jugadores, separados por comas</label>
<input id="names" value="Juan, Amigo 1, Amigo 2">
<p class="small">Se sortearán dos fichas para la mesa. Cada jugador roba fichas obligatorias.</p>
<button onclick="start()">Comenzar partida</button>
</section>
<section id="game">
<div class="card">
<div class="small">FICHAS COMPARTIDAS</div>
<div id="table" class="chips"></div>
<div id="notice">Comienza la partida.</div>
</div>
<div class="card">
<div class="small">TURNO ACTUAL</div>
<h2 id="current"></h2>
<div>Suma obligatoria: <span id="total" class="big">0</span></div>
<div id="hand" class="chips"></div>
<div id="best" class="small"></div>
<button onclick="draw()">Robar ficha</button>
<button onclick="stand()" class="secondary">Plantarse</button>
<button onclick="callSiglo()">¡Cantar SIGLO!</button>
</div>
<div class="card">
<h3>Jugadores</h3>
<div id="players"></div>
</div>
<button onclick="start()">Nueva ronda</button>
</section>
</main>
<script>
let players=[],deck=[],table=[],turn=0,done=false;
function shuffle(a){
 for(let i=a.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}
 return a;
}
function start(){
 const names=document.getElementById('names').value.split(',').map(x=>x.trim()).filter(Boolean);
 if(names.length<2){alert('Agrega al menos dos jugadores');return}
 players=names.map(name=>({name,hand:[],sum:0,stood:false,out:false}));
 deck=shuffle(Array.from({length:90},(_,i)=>i+1));
 table=[deck.pop(),deck.pop()];turn=0;done=false;
 document.getElementById('setup').style.display='none';
 document.getElementById('game').style.display='block';
 document.getElementById('notice').textContent='¡Que comience el juego!';
 render();
}
function currentPlayer(){return players[turn]}
function bestScore(p){
 return Math.max(...[p.sum,p.sum+table[0],p.sum+table[1],p.sum+table[0]+table[1]].filter(x=>x<=100),0);
}
function render(){
 document.getElementById('table').innerHTML=table.map(n=>'<div class="chip">'+n+'</div>').join('');
 let p=currentPlayer();
 document.getElementById('current').textContent=p.name;
 document.getElementById('total').textContent=p.sum;
 document.getElementById('hand').innerHTML=p.hand.map(n=>'<div class="chip">'+n+'</div>').join('');
 document.getElementById('best').textContent='Mejor resultado posible: '+bestScore(p);
 document.getElementById('players').innerHTML=players.map((x,i)=>'<div class="player '+(i===turn?'active':'')+'"><b>'+x.name+'</b> — suma '+x.sum+' · mejor '+bestScore(x)+(x.out?' · FUERA':x.stood?' · PLANTADO':'')+'</div>').join('');
}
function draw(){
 if(done)return;
 let p=currentPlayer();
 if(p.stood||p.out)return;
 if(!deck.length){finish();return}
 let n=deck.pop();p.hand.push(n);p.sum+=n;
 if(p.sum>100){p.out=true;document.getElementById('notice').textContent=p.name+' superó 100 y queda fuera.';next();return}
 document.getElementById('notice').textContent=p.name+' robó '+n+'.';
 render();
 if(bestScore(p)===100)document.getElementById('notice').textContent+=' ¡Puede cantar SIGLO!';
}
function stand(){
 let p=currentPlayer(),s=bestScore(p);
 if(s<90||s>99){alert('Solo puedes plantarte si tu mejor resultado está entre 90 y 99.');return}
 p.stood=true;document.getElementById('notice').textContent=p.name+' se planta con '+s+'.';next();
}
function callSiglo(){
 let p=currentPlayer();
 if(bestScore(p)!==100){alert('Debes poder sumar exactamente 100.');return}
 done=true;document.getElementById('notice').textContent='¡SIGLO! '+p.name+' gana la ronda.';render();
}
function next(){
 if(done)return;
 for(let i=1;i<=players.length;i++){
  let c=(turn+i)%players.length;
  if(!players[c].stood&&!players[c].out){turn=c;render();return}
 }
 finish();
}
function finish(){
 done=true;
 let eligible=players.filter(p=>!p.out);
 if(!eligible.length){document.getElementById('notice').textContent='Todos quedaron fuera.';return}
 let winner=eligible.reduce((a,b)=>bestScore(b)>bestScore(a)?b:a);
 document.getElementById('notice').textContent='Gana '+winner.name+' con '+bestScore(winner)+'.';render();
}
</script>
</body>
</html>
